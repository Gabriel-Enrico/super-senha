rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // As categorias existentes podem ser lidas por usuários autenticados,
    // mas só são alteradas manualmente no Console do Firebase.
    match /categorias/{categoryId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /palavras/{wordId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Cada conta acessa somente seus próprios temas personalizados.
    match /users/{userId}/temas/{themeId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Bloqueia acesso a qualquer caminho não previsto acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
