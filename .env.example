# Firebase web app configuration (client values; protect Firestore with rules).
EXPO_PUBLIC_FIREBASE_API_KEY=preencher
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=preencher
EXPO_PUBLIC_FIREBASE_PROJECT_ID=preencher
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=preencher
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=preencher
EXPO_PUBLIC_FIREBASE_APP_ID=preencher

# URL of the local Cloudflare Worker while testing in a browser.
EXPO_PUBLIC_AI_WORKER_URL=http://localhost:8787/generate-words
