*service-account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json
firebase-adminsdk*.json

# Firebase local emulator/debug state
.firebase/
firebase-debug.log
firestore-debug.log

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
